---
// Served by Cloudflare Pages with a real 404 status for any unknown URL.
import Layout from '../layouts/Layout.astro';
---
<Layout page="thanks" title="Page Not Found | JBG Plumbing" noindex>
  <section style="background:#716558;color:#fff;padding:clamp(72px,9vw,120px) 20px">
    <div style="max-width:1240px;margin:0 auto">
      <h1 style="margin:0;font-size:clamp(40px,6vw,80px);line-height:1;font-weight:900;color:#fff">Page Not Found</h1>
      <div style="width:60px;height:4px;background:#BD1E2D;margin-top:20px"></div>
      <p style="margin:20px 0 0;max-width:820px;font-size:clamp(18px,1.8vw,22px);line-height:1.5;color:#fff">That page moved or doesn't exist.</p>
    </div>
  </section>
  <section style="background:#fff;padding:clamp(56px,7vw,100px) 20px">
    <div style="max-width:760px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center;gap:20px">
      <p style="margin:0;font-size:17px;color:#3A3530">Need a plumber now? We're available 24/7.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center">
        <a class="h12" href="tel:9797774420" style="background:#BD1E2D;color:#fff;padding:16px 32px;border-radius:4px;font-weight:800;font-size:17px">(979) 777-4420</a>
        <a class="h9" href="/services/" style="border:2px solid #716558;color:#716558;padding:14px 30px;border-radius:4px;font-weight:800;font-size:17px">Our Services</a>
        <a class="h9" href="/" style="border:2px solid #716558;color:#716558;padding:14px 30px;border-radius:4px;font-weight:800;font-size:17px">Back to Home</a>
      </div>
    </div>
  </section>
</Layout>
