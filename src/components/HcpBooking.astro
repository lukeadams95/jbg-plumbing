---
import { BOOK_URL } from '../data/vals';

interface Props {
  wrapStyle?: string;
}

const {
  wrapStyle = 'background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);padding:clamp(16px,2.4vw,28px);min-width:0;overflow-x:hidden;box-sizing:border-box;color:#3A3530',
} = Astro.props;
---
<div id="book" style={wrapStyle}>
  <h2 style="margin:0;font-size:clamp(22px,2.4vw,28px);font-weight:800;color:#2B2622;line-height:1.1">Book Online</h2>
  <p style="margin:8px 0 12px;font-size:16px;line-height:1.45;color:#3A3530">Or call <a class="h5" href="tel:9797774420" style="font-weight:800;color:#BD1E2D;white-space:nowrap">(979) 777-4420</a></p>
  <iframe
    id="hcp-booking"
    class="hcp-booking-frame"
    title="Book a plumbing appointment with JBG Plumbing"
    src={BOOK_URL + '?v2=true'}
    referrerpolicy="strict-origin-when-cross-origin"
    style="width:100%;max-width:100%;height:680px;border:0;display:block;background:#fff;border-radius:4px"
  ></iframe>
  <p style="margin:10px 0 0;font-size:13px;line-height:1.4;color:#5C544C">
    <a class="h12" href={BOOK_URL} target="_blank" rel="noopener" style="color:#716558;font-weight:700">Open the booking form in a new tab</a>
  </p>
</div>
