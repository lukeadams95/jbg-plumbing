---
import { type PageKey } from '../../data/vals';
interface Props { page: PageKey }
---
<section style="position:relative;overflow:hidden;height:380px;display:flex;align-items:center;background:#716558;color:#fff;padding:0 20px">
  <div style="position:absolute;inset:-20px;background:url('/uploads/wp/JBG-Commercial-Plumbing-Team-Photo.jpg') center/cover no-repeat;filter:blur(7px)"></div>
  <div style="position:absolute;inset:0;background:rgba(113,101,88,.8)"></div>
  <div style="position:relative;width:100%;max-width:1240px;margin:0 auto">
    <h1 style="margin:0;font-size:clamp(44px,7vw,96px);line-height:1;font-weight:900;color:#fff">You're booked!</h1>
    <div style="width:60px;height:4px;background:#BD1E2D;margin-top:20px"></div>
    <p style="margin:20px 0 0;max-width:820px;font-size:clamp(18px,1.8vw,22px);line-height:1.5;color:#fff">We'll confirm your appointment shortly.</p>
  </div>
</section>
<section style="background:#fff;padding:clamp(56px,7vw,100px) 20px">
  <div style="max-width:760px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center;gap:20px">
    <svg width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="#716558" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:block"><circle cx="12" cy="12" r="10"></circle><path d="M7.5 12.5l3 3 6-6.5"></path></svg>
    <p style="margin:0;font-size:clamp(20px,2.2vw,26px);line-height:1.6;color:#2B2622">You're booked! We'll confirm your appointment shortly.</p>
    <p style="margin:0;font-size:17px;color:#3A3530">Need help right now? Call us 24/7.</p>
    <a class="h12" href="tel:9797774420" style="background:#BD1E2D;color:#fff;padding:16px 32px;border-radius:4px;font-weight:800;font-size:17px">(979) 777-4420</a>
  </div>
</section>
<script is:inline>
  if (typeof gtag === 'function') {
    gtag('event','booking_complete',{method:'housecallpro'});
  }
</script>
