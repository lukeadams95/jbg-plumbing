---
// GENERATED by tools/convert.mjs from the Claude Design prototype. Do not edit
// by hand: change the design (or the converter) and run `npm run convert`.
import { vals, type PageKey } from '../../data/vals';
interface Props { page: PageKey }
const { page } = Astro.props;
const V = vals(page);
---
<header style="position:sticky;top:0;z-index:50;background:#2B2622;box-shadow:0 2px 12px rgba(43,38,34,.25);padding:0 20px">
  <div style="max-width:1240px;margin:0 auto;position:relative">
    <div class="bp-desk">
      <a href="/" style="position:absolute;left:0;top:0;z-index:3;width:230px;height:126px;background:#fff;border-radius:0 0 22px 22px;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 18px rgba(0,0,0,.25)"><img src="/uploads/JBG-logo1.jpg" alt="JBG Commercial Plumbing" style="max-width:190px;max-height:84px;width:auto;height:auto" /></a>
      <div style="padding-left:254px;display:flex;justify-content:space-between;gap:16px;align-items:center;height:38px;color:#fff;font-size:14px;font-weight:500;border-bottom:1px solid #4A423B">
        <a href="https://www.google.com/maps?cid=14838878191929429427" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;letter-spacing:.03em;color:#fff"><span style="display:inline-flex;background:#fff;border-radius:4px;padding:1px 7px 2px;font-weight:700;font-size:15px;line-height:1.3;letter-spacing:0;text-transform:none;font-family:'Product Sans',Arial,sans-serif" aria-label="Google"><span style="color:#4285F4">G</span><span style="color:#EA4335">o</span><span style="color:#FBBC05">o</span><span style="color:#4285F4">g</span><span style="color:#34A853">l</span><span style="color:#EA4335">e</span></span><span style="font-weight:800">4.7</span><span style="color:#fff;letter-spacing:.1em">★★★★★</span><span>558 reviews</span></a>
        <span style="display:inline-flex;align-items:center;gap:18px"><span style="display:inline-flex;align-items:center;gap:8px;font-weight:800;letter-spacing:.08em;font-size:13px;color:#fff"><span style="width:9px;height:9px;border-radius:50%;background:#BD1E2D;flex:0 0 9px;animation:jbgPulse 1.6s infinite"></span>24/7 EMERGENCY SERVICE</span><a class="h1" href="tel:9797774420" style="color:#fff;font-weight:700">(979) 777-4420</a><span style="width:1px;height:16px;background:#4A423B"></span><a class="h1" href="/contact-us/" style="color:#fff;font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:13px">Contact Us</a></span>
      </div>
      <div style="padding-left:254px;display:flex;align-items:center;justify-content:space-between;gap:20px;height:78px">
        <nav style="display:flex;align-items:center;gap:0">
          {V.nav.map((n) => (<Fragment>
            <div class="dd-host" style="position:relative" data-item="nav">
              <a class="h2" href={n.href} style={`box-shadow:inset 0 -3px 0 ${n.bar};display:flex;align-items:center;gap:6px;padding:14px 7px;font-weight:700;font-size:13.5px;letter-spacing:.01em;text-transform:uppercase;color:#fff;white-space:nowrap`}>{n.label}{n.hasKids && (<Fragment><span style="font-size:18px;font-weight:400;line-height:1">+</span></Fragment>)}</a>
              {n.hasKids && (<div class="dd">
                <div style={`position:absolute;top:100%;left:0;min-width:${n.ddMin};display:${n.ddDisp};grid-template-rows:${n.ddRows};grid-auto-flow:${n.ddFlow};background:#fff;border-top:3px solid #716558;border-radius:0 0 8px 8px;box-shadow:0 12px 28px rgba(43,38,34,.25);padding:8px 0;z-index:5`}>
                  {n.kids.map((k) => (<Fragment>
                    <a class="h3" href={k.href} style={`display:block;padding:9px 20px;font-weight:${k.weight};font-size:${k.size};color:${k.color};text-transform:${k.tt};background:${k.bg};box-shadow:${k.ring};pointer-events:${k.pe}`} data-item="n.kids">{k.label}</a>
                  </Fragment>))}
                </div>
              </div>)}
            </div>
          </Fragment>))}
        </nav>
        <div style="display:flex;align-items:center;gap:12px"><a class="h4" href="tel:9797774420" style="background:#D9CFC6;color:#2B2622;padding:13px 18px;border-radius:999px;font-weight:800;font-size:14.5px;white-space:nowrap">(979) 777-4420</a>
        <a class="h5" href="/quote-request/" style={`background:#716558;color:#fff;box-shadow:${V.quoteRing};padding:13px 20px;border-radius:999px;font-weight:700;font-size:14px;text-transform:uppercase;white-space:nowrap`}>Request a Quote</a></div>
      </div>
    </div>
    <div class="bp-mob">
      <div style="height:32px;display:flex;align-items:center;justify-content:space-between;gap:10px;color:#fff;font-size:12.5px;white-space:nowrap;border-bottom:1px solid #4A423B">
        <a href="https://www.google.com/maps?cid=14838878191929429427" target="_blank" rel="noopener" aria-label="Rated 4.7 out of 5 from 558 Google reviews" style="display:inline-flex;align-items:center;gap:6px;color:#fff;min-width:0"><span style="display:inline-flex;background:#fff;border-radius:3px;padding:1px 5px;font-weight:700;font-size:12.5px;line-height:1.3;letter-spacing:0;text-transform:none;font-family:'Product Sans',Arial,sans-serif" aria-hidden="true"><span style="color:#4285F4">G</span><span style="color:#EA4335">o</span><span style="color:#FBBC05">o</span><span style="color:#4285F4">g</span><span style="color:#34A853">l</span><span style="color:#EA4335">e</span></span><span style="font-weight:800">4.7</span><span style="color:#fff;letter-spacing:.06em">★★★★★</span><span style="color:#D9CFC6">(558)</span></a>
        <span style="display:inline-flex;align-items:center;gap:6px;font-weight:800;letter-spacing:.06em;font-size:11.5px;color:#fff"><span style="width:8px;height:8px;border-radius:50%;background:#BD1E2D;flex:0 0 8px;animation:jbgPulse 1.6s infinite"></span>24/7 EMERGENCY</span>
      </div>
      <div style="height:62px;display:flex;align-items:center;justify-content:space-between;gap:12px">
        <a href="/" aria-label="JBG Commercial Plumbing home" style="display:flex;align-items:center;background:#fff;height:46px;padding:0 12px;border-radius:8px"><img src="/uploads/JBG-logo1.jpg" alt="JBG Commercial Plumbing" style="height:34px;width:auto;display:block" /></a>
        <div style="display:flex;align-items:center;gap:8px">
          <a href="tel:9797774420" aria-label="Call (979) 777-4420" style="width:42px;height:42px;border-radius:999px;background:#716558;display:flex;align-items:center;justify-content:center"><Fragment set:html={V.phoneIcon} /></a>
          <button data-act="menu" aria-label="Menu" style="width:42px;height:42px;border-radius:999px;border:1.5px solid #fff;background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center"><Fragment set:html={V.menuIcon} /></button>
        </div>
      </div>
    </div>
  </div>
  <div class="bp-mob" data-mobile-menu hidden>
    <div style="background:#fff;margin:0 -20px;padding:6px 20px 20px;max-height:calc(100vh - 150px);max-height:calc(100dvh - 150px);overflow:auto;overscroll-behavior:contain;border-top:3px solid #716558;box-shadow:0 14px 28px rgba(43,38,34,.3)">
      {V.nav.map((n) => (<Fragment>
        <div style="border-bottom:1px solid #E6E0DA;padding:10px 0" data-item="nav">
          <a href={n.href} style="display:block;font-weight:700;font-size:17px;color:#2B2622;padding:4px 0">{n.label}</a>
          {n.kids.map((k) => (<Fragment>
            <a href={k.href} style={`display:${k.mob};padding:6px 0 6px 14px;font-size:15px;font-weight:${k.weight};color:${k.color};text-transform:${k.tt}`} data-item="n.kids">{k.label}</a>
          </Fragment>))}
        </div>
      </Fragment>))}
      <a href="/quote-request/" style="display:block;text-align:center;margin-top:16px;background:#716558;color:#fff;padding:14px;border-radius:999px;font-weight:700">Request a Quote</a>
    </div>
  </div>
</header>
