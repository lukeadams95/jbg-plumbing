---
// GENERATED by tools/convert.mjs from the Claude Design prototype. Do not edit
// by hand: change the design (or the converter) and run `npm run convert`.
import { vals, type PageKey } from '../../data/vals';
interface Props { page: PageKey }
const { page } = Astro.props;
const V = vals(page);
---
<footer style="background:#2B2622;color:#E6E0DA;padding:clamp(48px,6vw,80px) 20px 28px">
  <div style="max-width:1240px;margin:0 auto">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:36px">
      <div style="display:flex;flex-direction:column;gap:16px;align-items:flex-start;min-width:0">
        <img src="/uploads/JBG-logo1.jpg" alt="JBG Commercial Plumbing" style="height:64px;width:auto;background:#fff;padding:6px 10px;border-radius:4px" />
        <a href="tel:9797774420" style="color:#fff;font-weight:800;font-size:26px">(979) 777-4420</a>
        <div><div style="font-weight:700;color:#fff;margin-bottom:4px;letter-spacing:.06em;font-size:14px">LICENSES</div>TXRMPL-39725; MMRF-21; BP001481; LaMP-11151; WSPS-21</div>
        <div><div style="font-weight:700;color:#fff;margin-bottom:4px;letter-spacing:.06em;font-size:14px">SERVICE AREAS</div>Houston/Austin/San Antonio/DFW · Shreveport/Baton Rouge/NOLA</div>
      </div>
      {V.footMenus.map((m) => (<Fragment>
        <div style="min-width:0" data-item="footMenus">
          <div style="font-weight:700;color:#fff;margin-bottom:8px;letter-spacing:.06em;font-size:14px;text-transform:uppercase;padding-bottom:8px;border-bottom:2px solid #716558;display:inline-block">{m.title}</div>
          <div style="display:flex;flex-direction:column;gap:2px">
            {m.links.map((l) => (<Fragment>
              <a class="h8" href={l.href} style={`display:block;padding:4px 0;color:${l.fc};font-weight:${l.fw};font-size:${l.fs};text-transform:${l.tt};letter-spacing:${l.ls}`} data-item="m.links">{l.label}</a>
            </Fragment>))}
          </div>
        </div>
      </Fragment>))}
    </div>
    <div style="height:1px;background:#4A423B;margin:44px 0 36px"></div>
    <div style="display:grid;grid-template-columns:var(--footGrid);gap:36px 24px">
      <div style="display:flex;flex-direction:column;min-width:0">
        <div style="font-weight:700;color:#fff;letter-spacing:0;font-size:18px;text-transform:uppercase;padding-bottom:10px;border-bottom:2px solid #716558;display:inline-block;align-self:flex-start;margin-bottom:18px">Our Office</div>
        <div style="flex:1;font-size:18px;line-height:1.9;color:#E6E0DA">JBG Plumbing<br />580 Graham Rd Ste D, College Station, TX 77845</div>
        <a href="tel:9797774420" style="color:#fff;font-weight:700;font-size:18px;display:inline-block;margin-top:8px">(979) 777-4420</a>
      </div>
      <div style="display:flex;flex-direction:column;min-width:0">
        <div style="font-weight:700;color:#fff;letter-spacing:0;font-size:18px;text-transform:uppercase;padding-bottom:10px;border-bottom:2px solid #716558;display:inline-block;align-self:flex-start;margin-bottom:18px">Counties We Serve</div>
        <div style="font-size:18px;line-height:1.9;color:#E6E0DA">Brazos County<br />Milam County<br />Robertson County<br />Grimes County</div>
      </div>
      <div style="display:flex;flex-direction:column;min-width:0">
        <div style="font-weight:700;color:#fff;letter-spacing:0;font-size:18px;text-transform:uppercase;padding-bottom:10px;border-bottom:2px solid #716558;display:inline-block;align-self:flex-start;margin-bottom:18px">24/7 Emergency Service</div>
        <div style="flex:1;font-size:18px;line-height:1.9;color:#E6E0DA">Day or night, our licensed plumbers are ready when you need us.</div>
        <a href="tel:9797774420" style="color:#fff;font-weight:700;font-size:18px;display:inline-block;margin-top:8px">(979) 777-4420</a>
      </div>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin:40px 0 28px">
      {V.socials.map((s) => (<Fragment>
        <a class="h9" href={s.href} target="_blank" rel="noopener" aria-label={s.name ? 'true' : 'false'} title={s.name} style="min-width:46px;height:46px;padding:0 12px;border-radius:4px;border:1.5px solid #716558;color:#fff;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center" data-item="socials">{s.short}</a>
      </Fragment>))}
    </div>
    <div style="border-top:1px solid #4A423B;padding-top:22px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:15px">
      <div style="display:flex;gap:6px 24px;flex-wrap:wrap">
        <a class="h8" href="/terms-of-service/" style="color:#E6E0DA">Terms of Service</a>
        <a class="h8" href="/privacy-policy/" style="color:#E6E0DA">Privacy Policy</a>
        <a class="h8" href="/locations/" style="color:#E6E0DA">Locations</a>
        <a class="h8" href="/quote-request/" style="color:#E6E0DA">Quote Request</a>
      </div>
      <div>© JBG Commercial Plumbing. All rights reserved.</div>
    </div>
  </div>
</footer>
