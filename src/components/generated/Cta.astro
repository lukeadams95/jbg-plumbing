---
// GENERATED by tools/convert.mjs from the Claude Design prototype. Do not edit
// by hand: change the design (or the converter) and run `npm run convert`.
import { type PageKey } from '../../data/vals';
interface Props { page: PageKey }

---
<section style="background:#716558;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:40px 40px;padding:clamp(64px,8vw,96px) 20px;color:#fff">
  <div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:var(--ctaCols);gap:clamp(36px,5vw,72px);align-items:center">
    <div>
      <div class="bp-cta-mob"><div style="display:flex;justify-content:center;margin-bottom:28px"><div style="width:120px;height:120px;"><svg viewBox="0 0 120 120" width="120" height="120" style="display:block;filter:drop-shadow(0 6px 14px rgba(43,38,34,.35))"><defs><path id="ctaRing" d="M 16,60 A 44,44 0 1 1 104,60 A 44,44 0 1 1 16,60"></path></defs><circle cx="60" cy="60" r="59" fill="#fff"></circle><circle cx="60" cy="60" r="56" fill="none" stroke="#716558" stroke-width="1.5"></circle><text font-family="Lato,sans-serif" font-weight="900" font-size="11.5" fill="#716558"><textPath href="#ctaRing" textLength="262" lengthAdjust="spacing">FAMILY-OWNED · 35 YEARS</textPath></text><circle cx="60" cy="60" r="33" fill="none" stroke="#BD1E2D" stroke-width="1.5" stroke-dasharray="4 3"></circle><text x="60" y="68" text-anchor="middle" font-family="Lato,sans-serif" font-weight="900" font-size="23" fill="#716558">JBG</text></svg></div></div></div>
      <div style="display:inline-flex;align-items:stretch;background:#fff;color:#2B2622;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:clamp(14px,1.5vw,18px)"><span style="background:#BD1E2D;width:22px;clip-path:polygon(0 0,100% 0,45% 100%,0 100%)"></span><span style="padding:9px 18px 9px 10px">GOT A PROJECT?</span></div>
      <h2 style="margin:16px 0 18px;font-size:clamp(36px,5vw,68px);line-height:1.02;font-weight:900;text-transform:uppercase;color:#fff">LET'S GET IT BUILT RIGHT.</h2>
      <div style="width:60px;height:4px;background:#BD1E2D;margin:0 0 22px"></div>
      <p style="margin:0 0 30px;max-width:560px;font-size:clamp(18px,1.8vw,21px);font-weight:400;line-height:1.7;color:rgba(255,255,255,.9)">Send us your plans or RFP and we'll get back to you with a quote. Need a repair instead? We're available 24/7.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;max-width:520px">
        <a class="h6" href="/quote-request/" style="display:inline-flex;align-items:center;justify-content:center;flex:1 1 220px;background:#fff;color:#2B2622;padding:18px 30px;border-radius:4px;font-weight:800;font-size:17px;border:2px solid #fff">→ Request a Quote</a>
        <a class="h5" href="tel:8885124107" style="flex:1 1 220px;text-align:center;border:2px solid #fff;color:#fff;padding:18px 30px;border-radius:4px;font-weight:700;font-size:17px">(888) 512-4107</a>
      </div>
      <div style="margin-top:22px;font-size:15px;color:rgba(255,255,255,.75)">Licensed in Texas &amp; Louisiana · TXRMPL-39725 · LaMP-11151</div>
    </div>
    <div style="position:relative;padding:0 0 var(--ctaPad) var(--ctaPad)">
      <div style="background:#fff;border-radius:6px;border-top:6px solid #BD1E2D;box-shadow:0 18px 40px rgba(43,38,34,.45);padding:clamp(20px,2.4vw,28px);color:#3A3530">
        <div data-state="sent" hidden>
          <div style="text-align:center;padding:36px 0">
            <div style="width:64px;height:64px;border-radius:50%;background:#716558;color:#fff;font-size:32px;display:flex;align-items:center;justify-content:center;margin:0 auto 18px">✓</div>
            <h3 style="margin:0 0 8px;font-size:28px;font-weight:800;color:#2B2622">Thank you!</h3>
            <p style="margin:0">We received your request and will be in touch shortly.</p>
          </div>
        </div>
        <div data-state="form">
          <h3 style="margin:0;font-size:clamp(24px,2.6vw,30px);font-weight:800;color:#2B2622;line-height:1.1">Request a Quote</h3>
          <div style="height:14px"></div>
          <form data-form="cta" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:10px">
            <label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#2B2622;text-align:left">Name<input required="" name="name" type="text" autocomplete="name" style="display:block;width:100%;box-sizing:border-box;padding:10px 12px;border:1.5px solid #E6E0DA;border-radius:4px;font:inherit;font-size:16px;color:#3A3530;background:#fff" /></label>
            <label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#2B2622;text-align:left">Phone<input required="" name="phone" type="tel" autocomplete="tel" style="display:block;width:100%;box-sizing:border-box;padding:10px 12px;border:1.5px solid #E6E0DA;border-radius:4px;font:inherit;font-size:16px;color:#3A3530;background:#fff" /></label>
            <label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#2B2622;text-align:left">Email<input required="" name="email" type="email" autocomplete="email" style="display:block;width:100%;box-sizing:border-box;padding:10px 12px;border:1.5px solid #E6E0DA;border-radius:4px;font:inherit;font-size:16px;color:#3A3530;background:#fff" /></label>
            <label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#2B2622;text-align:left;grid-column:1/-1">Project Details<textarea name="details" rows="2" style="display:block;width:100%;box-sizing:border-box;padding:10px 12px;border:1.5px solid #E6E0DA;border-radius:4px;font:inherit;font-size:16px;color:#3A3530;background:#fff;resize:vertical"></textarea></label>
            <button class="h7" type="submit" style="grid-column:1/-1;background:#716558;color:#fff;border:none;border-radius:4px;padding:13px;font:inherit;font-weight:800;font-size:16px;text-transform:uppercase;cursor:pointer">→ Send Request</button>
          </form>
        </div>
      </div>
      <div class="bp-cta-desk"><div style="width:120px;height:120px;position:absolute;left:0;bottom:0"><svg viewBox="0 0 120 120" width="120" height="120" style="display:block;filter:drop-shadow(0 6px 14px rgba(43,38,34,.35))"><defs><path id="ctaRingD" d="M 16,60 A 44,44 0 1 1 104,60 A 44,44 0 1 1 16,60"></path></defs><circle cx="60" cy="60" r="59" fill="#fff"></circle><circle cx="60" cy="60" r="56" fill="none" stroke="#716558" stroke-width="1.5"></circle><text font-family="Lato,sans-serif" font-weight="900" font-size="11.5" fill="#716558"><textPath href="#ctaRingD" textLength="262" lengthAdjust="spacing">FAMILY-OWNED · 35 YEARS</textPath></text><circle cx="60" cy="60" r="33" fill="none" stroke="#BD1E2D" stroke-width="1.5" stroke-dasharray="4 3"></circle><text x="60" y="68" text-anchor="middle" font-family="Lato,sans-serif" font-weight="900" font-size="23" fill="#716558">JBG</text></svg></div></div>
    </div>
  </div>
</section>
