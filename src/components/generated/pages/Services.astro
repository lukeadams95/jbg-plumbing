---
// GENERATED by tools/convert.mjs from the Claude Design prototype. Do not edit
// by hand: change the design (or the converter) and run `npm run convert`.
import { vals, type PageKey } from '../../../data/vals';
interface Props { page: PageKey }
const { page } = Astro.props;
const V = vals(page);
---
<section data-screen-label="Services Hero" style="position:relative;overflow:hidden;height:380px;display:flex;align-items:center;background:#716558;color:#fff;padding:0 20px">
  <div style="position:absolute;inset:-20px;background:url('https://i0.wp.com/jbgplumbingtx.com/wp-content/uploads/2017/12/Team-banner50-1-1500x630.jpg') center/cover no-repeat;filter:blur(7px)"></div>
  <div style="position:absolute;inset:0;background:rgba(113,101,88,.8)"></div>
  <div style="position:relative;width:100%;max-width:1240px;margin:0 auto">
    <h1 style="margin:0;font-size:clamp(44px,7vw,96px);line-height:1;font-weight:900;color:#fff">Our Services</h1>
    <div style="width:60px;height:4px;background:#BD1E2D;margin-top:20px"></div>
    <p style="margin:20px 0 0;max-width:900px;font-size:clamp(18px,1.8vw,22px);line-height:1.6;color:#fff;display:flex;flex-wrap:wrap;gap:2px 8px;align-items:baseline"><span>We're great at</span>{V.rotWords.map((r) => (<Fragment><span style="display:inline-flex;gap:8px" data-item="rotWords" data-rot><span style={`font-weight:${r.fw};color:${r.c};border-bottom:3px solid ${r.bd};transition:all .4s`}>{r.w}</span><span>{r.sep}</span></span></Fragment>))}</p>
  </div>
</section>
<section style="background:#fff;padding:clamp(56px,7vw,100px) 20px">
  <div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:clamp(28px,4vw,64px);align-items:center">
    <div style="min-width:0">
      <h2 style="margin:0 0 20px;font-size:clamp(30px,4vw,52px);line-height:1.1;font-weight:800;color:#2B2622">Professional Plumbing Contractor</h2>
      <div style="width:60px;height:4px;background:#BD1E2D;margin:0 0 26px"></div>
      <p style="margin:0 0 18px;font-size:19px;line-height:1.7">As a business owner, the last thing you need to worry about is unreliable plumbing on your property. Office suites, new commercial build-out, restaurants — you'll see that JBG handles very large projects. We retrofit existing buildings, keep older systems operating as efficiently as possible, or help you think through plumbing needs as you start from scratch. Let us deal with the plumbing problems, and you can get back to tackling the most important thing: managing your company!</p>
      <p style="margin:0 0 30px;font-size:19px;line-height:1.7">From one business to another, JBG understands the need for getting the job done right the first time.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px">
        <a class="h12" href="/quote-request/" style="background:#BD1E2D;color:#fff;padding:16px 28px;border-radius:4px;font-weight:800;font-size:16px">Request a Quote</a>
        <a class="h12" href="tel:9797774420" style="background:#716558;color:#fff;padding:16px 28px;border-radius:4px;font-weight:800;font-size:16px">(979) 777-4420</a>
        <a class="h9" href="/projects/" style="border:2px solid #716558;color:#716558;padding:14px 26px;border-radius:4px;font-weight:800;font-size:16px">View Recent Projects</a>
      </div>
    </div>
    <div style="min-width:0;border-radius:8px;overflow:hidden;box-shadow:0 14px 36px rgba(43,38,34,.16);border-bottom:6px solid #716558;background:#F4F1EE"><img src="https://i0.wp.com/jbgplumbingtx.com/wp-content/uploads/2016/11/plumber-collage-1.png" alt="JBG commercial plumbing collage" style="display:block;width:100%;height:auto" /></div>
  </div>
</section>
<section style="background:#2B2622;color:#fff;padding:clamp(56px,7vw,100px) 20px">
  <div style="max-width:1240px;margin:0 auto">
    <div style="display:grid;grid-template-columns:var(--featCols);gap:18px">
      {V.featured.map((f) => (<Fragment>
        <a class="h17" href={f.href} style="display:flex;align-items:center;gap:16px;background:#38322D;border:1px solid #4A423B;border-radius:6px;padding:22px;color:#fff;min-width:0" data-item="featured">
          <span style="flex:0 0 64px;height:64px;border-radius:6px;background:#716558;display:flex;align-items:center;justify-content:center"><Fragment set:html={f.icon} /></span>
          <span style="display:flex;flex-direction:column;gap:6px;min-width:0"><span style="font-weight:700;font-size:20px;line-height:1.25">{f.label}</span><span style="align-self:flex-start;color:#fff;font-weight:700;font-size:15px;border-bottom:2px solid #BD1E2D;padding-bottom:2px">Learn more →</span></span>
        </a>
      </Fragment>))}
    </div>
  </div>
</section>
<section style="background:#fff;padding:clamp(56px,7vw,100px) 20px">
  <div style="max-width:1240px;margin:0 auto">
    <div style="text-align:center"><div style="display:inline-flex;align-items:stretch;background:#F4F1EE;color:#2B2622;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:clamp(14px,1.5vw,18px);box-shadow:0 2px 10px rgba(43,38,34,.14);margin-bottom:16px"><span style="background:#BD1E2D;width:22px;clip-path:polygon(0 0,100% 0,45% 100%,0 100%)"></span><span style="padding:9px 18px 9px 10px">WE ALSO HANDLE</span></div><div style="width:60px;height:4px;background:#BD1E2D;margin:0 auto clamp(40px,5vw,64px)"></div></div>
    <div style="display:grid;grid-template-columns:var(--svcCols);gap:var(--svcGap)">
      {V.alsoCards.map((s) => (<Fragment>
        <a href={s.href} style="display:flex;flex-direction:column;color:#2B2622;min-width:0" data-item="alsoCards">
          <div style="height:var(--svcImgH);border-radius:12px 12px 0 0;overflow:hidden;background:#E6E0DA;display:flex;align-items:center;justify-content:center">{s.hasImg && (<Fragment><img src={s.img} alt={s.label} style="width:100%;height:100%;object-fit:cover;display:block" /></Fragment>)}{s.noImg && (<Fragment><span style="opacity:.45;padding-bottom:30px"><Fragment set:html={s.iconBig} /></span></Fragment>)}</div>
          <div class="h13" style="position:relative;flex:1;margin:var(--svcPull);background:#fff;border-radius:12px;box-shadow:0 8px 24px rgba(43,38,34,.14);padding:var(--svcPad);text-align:center;display:flex;flex-direction:column;align-items:center;gap:var(--svcInner)">
            <span style="position:absolute;top:var(--svcIconTop);left:50%;margin-left:var(--svcIconTop);width:var(--svcIconBox);height:var(--svcIconBox);border-radius:8px;background:#716558;display:flex;align-items:center;justify-content:center"><Fragment set:html={s.iconW} /></span>
            <span style="font-weight:800;font-size:var(--svcName);line-height:1.25;flex:1;display:flex;align-items:center">{s.label}</span>
            <span style="color:#716558;font-weight:700;font-size:var(--svcCta);border-bottom:2px solid #BD1E2D;padding-bottom:2px">{s.cta}</span>
          </div>
        </a>
      </Fragment>))}
    </div>
  </div>
</section>
<section style="background:#F4F1EE;padding:clamp(56px,7vw,100px) 20px">
  <div style="max-width:1240px;margin:0 auto">
    <h2 style="margin:0 0 20px;font-size:clamp(32px,4.2vw,56px);line-height:1.08;font-weight:800;color:#2B2622">Why Choose Us?</h2>
    <div style="width:60px;height:4px;background:#BD1E2D;margin:0 0 32px"></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:clamp(24px,4vw,56px);align-items:start">
      <div style="display:flex;flex-direction:column;gap:18px;min-width:0">
        <p style="margin:0;font-size:19px;line-height:1.7">Because we would choose JBG. After all, JBG is just like you. We own properties that require plumbing attention. We know what it's like to trust "professionals." We recognize when a job is done right the first time. We appreciate businesses that stand behind their work, communicate effectively, and prioritize customer service — you do too.</p>
        <p style="margin:0;font-size:19px;line-height:1.7">We want to be the kind of company we would want to hire. We've built a strong reputation throughout Texas and every job reinforces that reputation. We look people in the eye and deliver a great service at a competitive price. If we do that every single day, people will continue to notice. When capable professionals treat people well, people continue to choose us for their plumbing. JBG is building a Texas tradition one repair, one install, one customer at a time!</p>
      </div>
      <ul style="list-style:none;margin:0;padding:clamp(24px,3vw,36px);background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);display:flex;flex-direction:column;gap:18px;min-width:0"><li style="display:flex;align-items:center;gap:12px;font-size:19px;font-weight:700;color:#2B2622"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#BD1E2D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex:0 0 22px;display:block"><path d="M4 12.5l5 5 11-11"></path></svg><span>Cost effective upfront pricing</span></li><li style="display:flex;align-items:center;gap:12px;font-size:19px;font-weight:700;color:#2B2622"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#BD1E2D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex:0 0 22px;display:block"><path d="M4 12.5l5 5 11-11"></path></svg><span>Personal service</span></li><li style="display:flex;align-items:center;gap:12px;font-size:19px;font-weight:700;color:#2B2622"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#BD1E2D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex:0 0 22px;display:block"><path d="M4 12.5l5 5 11-11"></path></svg><span>No mess after the job</span></li><li style="display:flex;align-items:center;gap:12px;font-size:19px;font-weight:700;color:#2B2622"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#BD1E2D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex:0 0 22px;display:block"><path d="M4 12.5l5 5 11-11"></path></svg><span>Master plumbers</span></li><li style="display:flex;align-items:center;gap:12px;font-size:19px;font-weight:700;color:#2B2622"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#BD1E2D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex:0 0 22px;display:block"><path d="M4 12.5l5 5 11-11"></path></svg><span>Fully stocked trucks</span></li><li style="display:flex;align-items:center;gap:12px;font-size:19px;font-weight:700;color:#2B2622"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#BD1E2D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex:0 0 22px;display:block"><path d="M4 12.5l5 5 11-11"></path></svg><span>Warranty</span></li><li style="display:flex;align-items:center;gap:12px;font-size:19px;font-weight:700;color:#2B2622"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#BD1E2D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex:0 0 22px;display:block"><path d="M4 12.5l5 5 11-11"></path></svg><span>24/7 emergency repair</span></li></ul>
    </div>
  </div>
</section>
