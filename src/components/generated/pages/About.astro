---
// GENERATED by tools/convert.mjs from the Claude Design prototype. Do not edit
// by hand: change the design (or the converter) and run `npm run convert`.
import { vals, type PageKey } from '../../../data/vals';
interface Props { page: PageKey }
const { page } = Astro.props;
const V = vals(page);
---
<section data-screen-label="About Us Hero" style="position:relative;overflow:hidden;height:380px;display:flex;align-items:center;background:#716558;color:#fff;padding:0 20px">
  <div style="position:absolute;inset:-20px;background:url('https://i0.wp.com/jbgplumbingtx.com/wp-content/uploads/2016/11/about-us2-1.jpg') center/cover no-repeat;filter:blur(7px)"></div>
  <div style="position:absolute;inset:0;background:rgba(113,101,88,.8)"></div>
  <div style="position:relative;width:100%;max-width:1240px;margin:0 auto">
    <h1 style="margin:0;font-size:clamp(44px,7vw,96px);line-height:1;font-weight:900;color:#fff">About Us</h1>
    <div style="width:60px;height:4px;background:#BD1E2D;margin-top:20px"></div>
  </div>
</section>
<section style="background:#fff;padding:clamp(56px,7vw,100px) 20px">
  <div style="max-width:1240px;margin:0 auto">
    <div style="display:inline-flex;align-items:stretch;background:#F4F1EE;color:#2B2622;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:clamp(14px,1.5vw,18px);box-shadow:0 2px 10px rgba(43,38,34,.14);margin-bottom:24px"><span style="background:#BD1E2D;width:22px;clip-path:polygon(0 0,100% 0,45% 100%,0 100%)"></span><span style="padding:9px 18px 9px 10px">TEXAS COMMUNITY PLUMBERS</span></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:clamp(20px,4vw,56px)">
      <p style="margin:0;font-size:19px;line-height:1.7">JBG is a family-owned plumbing company proud to celebrate 35 years living and working right here in the Brazos Valley. We started right here in Aggieland, but we've grown to cover most major Texas cities — we've seen our customers become our friends and we've watched this community develop year by year. It's a special place, and we are proud to call Texas our home.</p>
      <p style="margin:0;font-size:19px;line-height:1.7">When you call JBG, you're hiring a team of dedicated professionals — licensed contractors and expert technicians. Residential and commercial property owners know us by our reputation — a name we're proud to put on our service trucks. JBG means something special, and we never forget that when we work on your property.</p>
    </div>
  </div>
</section>
<section style="background:#F4F1EE;padding:clamp(56px,7vw,100px) 20px">
  <div style="max-width:1240px;margin:0 auto">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px;align-items:stretch">
      <div style="grid-column:span 2;min-width:0;position:relative;min-height:380px;border-radius:6px;overflow:hidden;background:#E6E0DA;box-shadow:0 10px 30px rgba(43,38,34,.18)">
        <iframe src={V.mapSrc} title="JBG Plumbing College Station office map" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;border:0;filter:sepia(.35) saturate(.8)"></iframe>
      </div>
      <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
        <div style="display:flex;flex-direction:column;gap:8px;background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 4px 14px rgba(43,38,34,.1);padding:24px">
          <span style="font-weight:900;text-transform:uppercase;letter-spacing:.02em;font-size:22px;line-height:1.2;color:#2B2622">JBG Plumbing — College Station</span>
          <span style="font-size:16px;line-height:1.5">580 Graham Rd Ste D, College Station, TX 77845</span>
          <a class="h14" href="tel:9797774420" style="font-weight:700;font-size:18px;color:#716558">(979) 777-4420</a>
          <a class="h10" href="https://www.google.com/maps/search/?api=1&query=580+Graham+Rd+Ste+D+College+Station+TX+77845" target="_blank" rel="noopener" style="align-self:flex-start;margin-top:8px;background:#716558;color:#fff;padding:12px 24px;border-radius:4px;font-weight:700;font-size:15.5px">Get Directions</a>
        </div>
        <div style="flex:1;display:flex;flex-direction:column;gap:12px;background:#fff;border-radius:6px;border-top:4px solid #716558;box-shadow:0 4px 14px rgba(43,38,34,.1);padding:24px">
          <span style="font-weight:900;text-transform:uppercase;letter-spacing:.02em;font-size:18px;color:#2B2622">Counties We Serve</span>
          <span style="font-size:17px;line-height:1.7;flex:1">Brazos County · Milam County · Robertson County · Grimes County</span>
          <a class="h10" href="tel:9797774420" style="text-align:center;background:#BD1E2D;color:#fff;padding:15px 24px;border-radius:4px;font-weight:800;font-size:16.5px">Call 24/7: (979) 777-4420</a>
        </div>
      </div>
    </div>
  </div>
</section>
<section style="background:#fff;padding:clamp(56px,7vw,100px) 20px">
  <div style="max-width:1240px;margin:0 auto;text-align:center">
    <h2 style="margin:0 0 20px;font-size:clamp(28px,3.6vw,44px);line-height:1.15;font-weight:800;color:#2B2622">JBG Commercial Plumbing Team</h2>
    <div style="width:60px;height:4px;background:#BD1E2D;margin:0 auto 36px"></div>
    <div style="border-radius:8px;overflow:hidden;box-shadow:0 14px 36px rgba(43,38,34,.16);border-bottom:6px solid #716558;background:#F4F1EE"><img src="https://i0.wp.com/jbgplumbingtx.com/wp-content/uploads/2016/11/JBG-Commercial-Plumbing-Team-1267x430.jpg" alt="JBG Commercial Plumbing Team" style="display:block;width:100%;aspect-ratio:1267/430;min-height:160px;object-fit:cover" /></div>
  </div>
</section>
