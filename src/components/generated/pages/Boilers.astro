<section data-screen-label="Commercial Boilers Hero" style="position:relative;overflow:hidden;height:380px;display:flex;align-items:center;background:#716558;color:#fff;padding:0 20px">
  <div style="position:absolute;inset:-20px;background:url('https://i0.wp.com/jbgplumbingtx.com/wp-content/uploads/2017/10/Broiler-Installation-Repair-1500x430.jpg') center/cover no-repeat;filter:blur(7px)"></div>
