---
// GENERATED by tools/convert.mjs from the Claude Design prototype. Do not edit
// by hand: change the design (or the converter) and run `npm run convert`.
import { vals, type PageKey } from '../../../data/vals';
interface Props { page: PageKey }
const { page } = Astro.props;
const V = vals(page);
---
<section data-screen-label="Contact Us Hero" style="position:relative;overflow:hidden;height:380px;display:flex;align-items:center;background:#716558;color:#fff;padding:0 20px">
  <div style="position:absolute;inset:-20px;background:url('https://i0.wp.com/jbgplumbingtx.com/wp-content/uploads/2016/12/JBG-Commercial-Plumbing-Team-Photo.jpg') center/cover no-repeat;filter:blur(7px)"></div>
  <div style="position:absolute;inset:0;background:rgba(113,101,88,.8)"></div>
  <div style="position:relative;width:100%;max-width:1240px;margin:0 auto">
    <h1 style="margin:0;font-size:clamp(44px,7vw,96px);line-height:1;font-weight:900;color:#fff">Contact Us</h1>
    <div style="width:60px;height:4px;background:#BD1E2D;margin-top:20px"></div>
    <p style="margin:20px 0 0;max-width:820px;font-size:clamp(18px,1.8vw,22px);line-height:1.5;color:#fff">Questions, scheduling or emergencies, we're here 24/7.</p>
  </div>
</section>
<section style="background:#F4F1EE;padding:clamp(48px,6vw,88px) 20px 0">
  <div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:var(--cwCols);gap:24px;align-items:stretch">
    <div style="background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);padding:clamp(22px,2.4vw,30px);display:flex;flex-direction:column;align-items:flex-start;gap:12px;min-width:0"><h3 style="margin:0;font-weight:900;text-transform:uppercase;font-size:20px;line-height:1.2;color:#2B2622">Call Us 24/7</h3><a class="h15" href="tel:9797774420" style="font-weight:900;font-size:clamp(22px,2.2vw,26px);color:#716558">(979) 777-4420</a><span style="font-size:15.5px;line-height:1.5;color:#3A3530;margin-top:auto">For emergencies, day or night.</span></div>
    <div style="background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);padding:clamp(22px,2.4vw,30px);display:flex;flex-direction:column;align-items:flex-start;gap:12px;min-width:0"><h3 style="margin:0;font-weight:900;text-transform:uppercase;font-size:20px;line-height:1.2;color:#2B2622">Office</h3><a class="h15" href="tel:9797774420" style="font-weight:900;font-size:clamp(22px,2.2vw,26px);color:#716558">(979) 777-4420</a><span style="font-size:15.5px;line-height:1.5;color:#3A3530;margin-top:auto">College Station office.</span></div>
    <div style="background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);padding:clamp(22px,2.4vw,30px);display:flex;flex-direction:column;align-items:flex-start;gap:12px;min-width:0"><h3 style="margin:0;font-weight:900;text-transform:uppercase;font-size:20px;line-height:1.2;color:#2B2622">Book Online</h3><a class="h12" href="https://book.housecallpro.com/book/JBG-Plumbing/4e36de049beb46bc86918c304ca376cb" target="_blank" rel="noopener" style="background:#716558;color:#fff;padding:14px 26px;border-radius:4px;font-weight:800;font-size:16px">Book Online</a><span style="font-size:15.5px;line-height:1.5;color:#3A3530;margin-top:auto">Pick a time that works for you.</span></div>
    <div style="background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);padding:clamp(22px,2.4vw,30px);display:flex;flex-direction:column;align-items:flex-start;gap:12px;min-width:0"><h3 style="margin:0;font-weight:900;text-transform:uppercase;font-size:20px;line-height:1.2;color:#2B2622">Request a Quote</h3><a class="h12" href="/quote-request/" style="background:#716558;color:#fff;padding:14px 26px;border-radius:4px;font-weight:800;font-size:16px">Request a Quote</a><span style="font-size:15.5px;line-height:1.5;color:#3A3530;margin-top:auto">Have a project, plans or an RFP? Send us the details.</span></div>
  </div>
</section>
<section style="background:#F4F1EE;padding:clamp(40px,5vw,72px) 20px clamp(56px,7vw,100px)">
  <div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:var(--cfCols);gap:clamp(24px,3vw,40px);align-items:start">
    <div style="background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);padding:clamp(24px,3.4vw,44px);min-width:0">
      <div data-state="sent" hidden>
        <div style="text-align:center;padding:48px 0">
          <div style="width:64px;height:64px;border-radius:50%;background:#716558;color:#fff;font-size:32px;display:flex;align-items:center;justify-content:center;margin:0 auto 18px">✓</div>
          <h3 style="margin:0 0 8px;font-size:30px;font-weight:800;color:#2B2622">Thank you!</h3>
          <p style="margin:0;font-size:18px;line-height:1.6">Your message has been received. Our team will get back to you soon.</p>
        </div>
      </div>
      <div data-state="form">
      <form data-form="contact" novalidate style="display:flex;flex-direction:column;gap:26px">
        <div><h2 style="margin:0 0 12px;font-size:clamp(26px,3vw,36px);line-height:1.15;font-weight:800;color:#2B2622">Send Us a Message</h2><p style="margin:0;font-size:18px;line-height:1.6">Fill out the form and our team will get back to you. Fields marked * are required.</p></div>
        <div><span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Name<span style="color:#BD1E2D">*</span></span><div style="display:grid;grid-template-columns:var(--qPair);gap:14px"><div><span style="display:block;font-weight:700;font-size:14px;color:#716558;margin:0 0 6px">First</span><div style="min-width:0"><input class="f1" type="text" name="first" aria-label="First" style={`border:1.5px solid ${V.cb.first};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;`} /><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="first"></span></div></div><div><span style="display:block;font-weight:700;font-size:14px;color:#716558;margin:0 0 6px">Last</span><div style="min-width:0"><input class="f1" type="text" name="last" aria-label="Last" style={`border:1.5px solid ${V.cb.last};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;`} /><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="last"></span></div></div></div></div>
        <div><span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Phone<span style="color:#BD1E2D">*</span></span><div style="min-width:0"><input class="f1" type="tel" name="phone" aria-label="Phone" style={`border:1.5px solid ${V.cb.phone};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;`} /><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="phone"></span></div></div>
        <div><span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Email<span style="color:#BD1E2D">*</span></span><div style="min-width:0"><input class="f1" type="email" name="email" aria-label="Email" style={`border:1.5px solid ${V.cb.email};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;`} /><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="email"></span></div></div>
        <div><span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Preferred Contact Method<span style="color:#BD1E2D">*</span></span><div style="display:flex;flex-wrap:wrap;gap:12px">{V.cmOpts.map((o) => (<Fragment><button type="button" data-act="pick" aria-pressed={o.on ? 'true' : 'false'} style={`padding:12px 24px;border-radius:999px;border:2px solid ${o.bd};background:${o.bg};color:${o.fg};font-family:inherit;font-weight:800;font-size:16px;cursor:pointer`} data-item="cmOpts" data-val={o.label}>{o.label}</button></Fragment>))}</div><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="method"></span></div>
        <div><span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Message<span style="color:#BD1E2D">*</span></span><textarea class="f1" rows="6" name="message" aria-label="Message" style={`border:1.5px solid ${V.cb.message};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;resize:vertical;line-height:1.5`}></textarea><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="message"></span></div>
        <div style="display:flex;flex-direction:column;gap:14px;align-items:flex-start">
          <button class="h12" type="submit" style="background:#BD1E2D;color:#fff;border:0;border-radius:4px;padding:18px 40px;font-family:inherit;font-weight:800;font-size:17px;cursor:pointer">Send Message</button>
          <span style="font-size:15.5px;color:#3A3530">Need a plumber right now? Call us 24/7 at <a class="h15" href="tel:9797774420" style="font-weight:700;color:#716558">(979) 777-4420</a>.</span>
        </div>
      </form>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
      <div style="position:relative;min-height:340px;border-radius:6px;overflow:hidden;background:#E6E0DA;box-shadow:0 10px 30px rgba(43,38,34,.18)"><iframe src={V.mapSrc} title="JBG Plumbing College Station office map" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;border:0;filter:sepia(.35) saturate(.8)"></iframe></div>
      <div style="background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 4px 14px rgba(43,38,34,.1);padding:24px;display:flex;flex-direction:column;gap:8px">
        <span style="font-weight:900;text-transform:uppercase;font-size:22px;line-height:1.2;color:#2B2622">JBG Plumbing</span>
        <span style="font-size:17px;line-height:1.5">580 Graham Rd Ste D, College Station, TX 77845</span>
        <a class="h12" href="https://www.google.com/maps/search/?api=1&amp;query=580+Graham+Rd+Ste+D+College+Station+TX+77845" target="_blank" rel="noopener" style="align-self:flex-start;margin:6px 0;background:#716558;color:#fff;padding:12px 24px;border-radius:4px;font-weight:700;font-size:15.5px">Get Directions</a>
        <span style="font-size:16px;line-height:1.5;color:#3A3530">Serving Brazos, Milam, Robertson and Grimes County</span>
      </div>
    </div>
  </div>
</section>
<section style="background:#2B2622;color:#fff;padding:clamp(48px,6vw,88px) 20px">
  <div style="max-width:1240px;margin:0 auto;text-align:center">
    <h2 style="margin:0 0 20px;font-size:clamp(28px,3.8vw,48px);line-height:1.12;font-weight:800;color:#fff">Find Us Online</h2>
    <div style="width:60px;height:4px;background:#BD1E2D;margin:0 auto 32px"></div>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-bottom:28px">
      {V.findUs.map((s) => (<Fragment><a class="h20" href={s.href} target="_blank" rel="noopener" aria-label={s.name ? 'true' : 'false'} title={s.name} style="min-width:64px;height:56px;padding:0 18px;border-radius:6px;border:1.5px solid #716558;background:#38322D;color:#fff;font-weight:800;font-size:16px;display:flex;align-items:center;justify-content:center" data-item="findUs">{s.short}</a></Fragment>))}
    </div>
    <p style="margin:0;font-size:17px;line-height:1.6;color:#E6E0DA">Licensed Plumbers · TXRMPL-39725 · MMRF-21 · BP001481 · LaMP-11151 · WSPS-21</p>
  </div>
</section>
