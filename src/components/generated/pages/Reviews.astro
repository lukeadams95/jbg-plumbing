---
// GENERATED by tools/convert.mjs from the Claude Design prototype. Do not edit
// by hand: change the design (or the converter) and run `npm run convert`.
import { vals, type PageKey } from '../../../data/vals';
interface Props { page: PageKey }
const { page } = Astro.props;
const V = vals(page);
---
<section data-screen-label="Reviews Hero" style="position:relative;overflow:hidden;height:380px;display:flex;align-items:center;background:#716558;color:#fff;padding:0 20px">
  <div style="position:absolute;inset:-20px;background:url('https://i0.wp.com/jbgplumbingtx.com/wp-content/uploads/2017/12/Team-banner50-1-1500x630.jpg') center/cover no-repeat;filter:blur(7px)"></div>
  <div style="position:absolute;inset:0;background:rgba(113,101,88,.8)"></div>
  <div style="position:relative;width:100%;max-width:1240px;margin:0 auto">
    <h1 style="margin:0;font-size:clamp(44px,7vw,96px);line-height:1;font-weight:900;color:#fff">Reviews</h1>
    <div style="width:60px;height:4px;background:#BD1E2D;margin-top:20px"></div>
    <p style="margin:20px 0 0;max-width:720px;font-size:clamp(18px,1.8vw,22px);line-height:1.5;color:#fff">Hear it from our customers.</p>
  </div>
</section>
<section style="background:#fff;padding:clamp(40px,5vw,64px) 20px;border-bottom:1px solid #E6E0DA">
  <div style="max-width:1240px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:20px 32px;text-align:center">
    <svg width="52" height="52" viewBox="0 0 48 48" style="flex:0 0 52px;display:block"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path></svg>
    <span style="font-weight:900;font-size:clamp(52px,6vw,72px);line-height:1;color:#2B2622">4.7</span>
    <span style="display:flex;flex-direction:column;align-items:flex-start;gap:6px"><span style="color:#FABB05;font-size:28px;letter-spacing:2px;line-height:1">★★★★★</span><span style="font-size:17px;color:#3A3530">Based on 558 Google reviews</span></span>
    <a class="h11" href="https://www.google.com/maps?cid=14838878191929429427" target="_blank" rel="noopener" style="background:#716558;color:#fff;padding:15px 28px;border-radius:4px;font-weight:800;font-size:16px">See Us on Google</a>
  </div>
</section>
<section style="background:#F4F1EE;padding:clamp(56px,7vw,96px) 20px">
  <div style="max-width:1240px;margin:0 auto">
    <div style="column-count:var(--revCols);column-gap:24px">
      {V.allReviews.map((r) => (<Fragment>
        <div style="break-inside:avoid;display:block;margin:0 0 24px;background:#fff;border:1px solid #E6E0DA;border-radius:6px;padding:24px" data-item="allReviews" hidden={r.hidden}>
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
            <div style="font-family:'Lato',sans-serif;font-weight:700;font-size:16px;color:#2B2622;text-transform:none;letter-spacing:0" data-name>{r.name}</div>
            <svg width="22" height="22" viewBox="0 0 48 48" style="flex:0 0 22px;display:block"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path></svg>
          </div>
          <div style="display:flex;align-items:center;gap:8px;margin:6px 0 14px"><span style="color:#FABB05;font-size:18px;letter-spacing:1px;line-height:1">★★★★★</span><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#716558" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block"><circle cx="12" cy="12" r="10"></circle><path d="M7.5 12.5l3 3 6-6.5"></path></svg></div>
          <div style="font-family:'Lato',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3A3530;white-space:pre-line" data-text>{r.text}</div>
        </div>
      </Fragment>))}
    </div>
    <div style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:18px;margin-top:12px">
      <div style="font-family:'Lato',sans-serif;font-size:14px;color:#5A5046">Showing <span data-shown>{V.allShown}</span> of {V.allTotal} reviews</div>
      {V.allCanLoad && (<Fragment>
        <button class="h7" data-act="more" data-list="allReviews" data-step={30} style="background:#716558;color:#fff;border:none;border-radius:4px;min-height:48px;padding:0 32px;font-family:'Lato',sans-serif;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:.08em;cursor:pointer">LOAD MORE REVIEWS</button>
      </Fragment>)}
    </div>
  </div>
</section>
