---
// GENERATED by tools/convert.mjs from the Claude Design prototype. Do not edit
// by hand: change the design (or the converter) and run `npm run convert`.
import { vals, type PageKey } from '../../../data/vals';
interface Props { page: PageKey }
const { page } = Astro.props;
const V = vals(page);
---
<section style="position:relative;overflow:hidden;min-height:calc(100vh - 116px);display:flex;align-items:center;background:#716558;color:#fff">
  <div style="position:absolute;inset:-20px;background:url('/uploads/IHOP-Image.jpg') center/cover no-repeat;filter:blur(7px)"></div>
  <div style="position:absolute;inset:0;background:rgba(113,101,88,.8)"></div>
  <div style="position:absolute;top:0;bottom:0;left:max(20px,calc(50% - 620px));width:1px;background:rgba(255,255,255,.25)"></div>
  <div style="position:absolute;top:0;bottom:0;right:max(20px,calc(50% - 620px));width:1px;background:rgba(255,255,255,.25)"></div>
  <div style="position:relative;width:100%;max-width:1240px;margin:0 auto;padding:clamp(28px,3.5vw,48px) 20px clamp(32px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(40px,6vw,80px);align-items:center">
    <div>
      <div style="display:inline-flex;align-items:stretch;background:#fff;color:#2B2622;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:clamp(14px,1.5vw,18px)"><span style="background:#BD1E2D;width:22px;clip-path:polygon(0 0,100% 0,45% 100%,0 100%)"></span><span style="padding:9px 18px 9px 10px">THE PLUMBER WE’D HIRE</span></div>
      <h1 style="margin:14px 0 18px;font-size:clamp(44px,6vw,86px);line-height:1;font-weight:800;letter-spacing:-.01em">DONE RIGHT.<br />FIRST TIME.</h1>
      <div style="width:60px;height:4px;background:#BD1E2D;margin:0 0 20px"></div>
      <p style="max-width:540px;font-size:clamp(18px,1.8vw,21px);font-weight:500;margin:0 0 12px">We own properties too, so we treat every job the way we’d want ours done.</p>
      <p style="max-width:540px;font-size:clamp(18px,1.8vw,21px);font-weight:500;margin:0 0 28px">Day or night, our licensed plumbers are ready when you need us.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;max-width:520px">
        <a class="h10" href="/quote-request/" style="display:inline-flex;align-items:center;justify-content:center;gap:14px;flex:1 1 220px;background:#fff;color:#716558;padding:20px 30px;font-weight:800;font-size:17px;text-transform:uppercase;box-shadow:0 6px 18px rgba(43,38,34,.2)">→ Request a Quote</a>
        <a class="h5" href="tel:8885124107" style="flex:1 1 220px;text-align:center;border:2px solid #fff;color:#fff;padding:18px 28px;font-weight:700;font-size:17px">(888) 512-4107</a>
      </div>
    </div>
    <div style="position:relative;padding:0 0 0 clamp(0px,3vw,40px)">
      <img src="/uploads/plumber-collage-2.png" alt="JBG plumbers at work" style="display:block;width:100%;max-height:calc(100vh - 220px);object-fit:contain;filter:drop-shadow(0 18px 30px rgba(43,38,34,.4))" />
      <div style="position:absolute;left:clamp(-10px,-1vw,0px);bottom:6%;width:clamp(140px,16vw,190px);aspect-ratio:1;transform:rotate(-12deg);filter:drop-shadow(0 8px 18px rgba(43,38,34,.35))">
        <svg viewBox="0 0 200 200" width="100%" height="100%" style="display:block" role="img" aria-label="24/7 Emergency Service">
          <defs>
            <path id="stampTop" d="M 30,100 A 70,70 0 0 1 170,100"></path>
            <path id="stampBot" d="M 14,100 A 86,86 0 0 0 186,100"></path>
          </defs>
          <circle cx="100" cy="100" r="98" fill="#fff"></circle>
          <circle cx="100" cy="100" r="93" fill="none" stroke="#716558" stroke-width="3"></circle>
          <circle cx="100" cy="100" r="58" fill="none" stroke="#BD1E2D" stroke-width="1.5" stroke-dasharray="4 4"></circle>
          <text font-family="Lato, sans-serif" font-weight="900" font-size="19" letter-spacing="3" fill="#716558" text-anchor="middle"><textPath href="#stampTop" startOffset="50%">EMERGENCY</textPath></text>
          <text font-family="Lato, sans-serif" font-weight="900" font-size="19" letter-spacing="4" fill="#716558" text-anchor="middle"><textPath href="#stampBot" startOffset="50%">SERVICE</textPath></text>
          <circle cx="20" cy="100" r="3.5" fill="#BD1E2D"></circle>
          <circle cx="180" cy="100" r="3.5" fill="#BD1E2D"></circle>
          <text x="100" y="114" font-family="Lato, sans-serif" font-weight="900" font-size="42" fill="#716558" text-anchor="middle">24/7</text>
        </svg>
      </div>
    </div>
  </div>
</section>

<section style="background:#F4F1EE;padding:clamp(40px,6vw,80px) 20px">
  <div style="max-width:1240px;margin:0 auto;background:#fff;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));box-shadow:0 20px 50px rgba(0,0,0,.35)">
    <div style="position:relative;display:flex;align-items:center;min-height:300px;background:#716558 url('/uploads/IHOP-Image.jpg') center/cover no-repeat;clip-path:var(--clipSlant);margin-right:var(--slantPull)">
      <div style="position:absolute;inset:0;background:rgba(113,101,88,.88)"></div>
      <h2 style="position:relative;margin:0;padding:clamp(36px,5vw,64px) clamp(28px,5vw,64px);padding-right:clamp(60px,9vw,120px);color:#fff;font-size:clamp(32px,4.2vw,56px);line-height:1.08;font-weight:800">Professional Plumbing Contractor</h2>
    </div>
    <div style="display:flex;flex-direction:column;justify-content:center;gap:18px;padding:clamp(32px,4vw,56px) clamp(28px,5vw,64px)">
      <div style="display:inline-flex;align-items:stretch;background:#F4F1EE;color:#2B2622;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:clamp(14px,1.5vw,18px);box-shadow:0 2px 10px rgba(43,38,34,.14);margin-bottom:0;align-self:flex-start"><span style="background:#BD1E2D;width:22px;clip-path:polygon(0 0,100% 0,45% 100%,0 100%)"></span><span style="padding:9px 18px 9px 10px">Who We Are</span></div><div style="width:60px;height:4px;background:#BD1E2D"></div>
      <p style="margin:0;font-size:clamp(20px,2.2vw,28px);line-height:1.35;font-weight:700;color:#2B2622">New Construction &amp; Commercial Plumbing in College Station, Houston, Austin, Dallas and San Antonio</p>
    </div>
  </div>
</section>

<section style="background:#fff;padding:clamp(56px,7vw,100px) 20px">
  <div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:clamp(36px,6vw,80px);align-items:center">
    <div style="position:relative;margin:0 0 0 clamp(0px,2vw,24px)">
      <div style="position:absolute;left:-24px;top:-24px;right:24px;bottom:24px;border:2px solid #E6E0DA"></div>
      <div style="position:absolute;left:0;top:0;right:0;bottom:0;background:#F4F1EE;box-shadow:0 14px 36px rgba(43,38,34,.12)"></div>
      <img src="/uploads/plumber-collage-1.png" alt="JBG plumbers at work" style="position:relative;display:block;width:100%;padding:clamp(16px,3vw,36px);box-sizing:border-box" />
    </div>
    <div>
      <div style="display:inline-flex;align-items:stretch;background:#F4F1EE;color:#2B2622;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:clamp(14px,1.5vw,18px);box-shadow:0 2px 10px rgba(43,38,34,.14);margin-bottom:16px"><span style="background:#BD1E2D;width:22px;clip-path:polygon(0 0,100% 0,45% 100%,0 100%)"></span><span style="padding:9px 18px 9px 10px">About JBG</span></div><h2 style="margin:0 0 20px;font-size:clamp(32px,4.2vw,56px);line-height:1.08;font-weight:800;color:#2B2622">Looking for a Commercial or Residential Plumber in Texas?</h2>
      <div style="width:60px;height:4px;background:#BD1E2D;margin:0 0 24px"></div>
      <p style="margin:0;font-size:19px;line-height:1.65">JBG Plumbing has grown its plumbing business one building at a time. With many of our clients referring us to their peers who own the same business brand across town. We can remodel all of the restrooms in your office building or build-out your new plumbing fixtures from scratch. We also work on residential homes for things like leaky faucets or tankless water heater upgrades.</p>
      <div style="height:1px;background:#E6E0DA;margin:32px 0"></div>
      <div style="display:flex;flex-wrap:wrap;gap:14px;max-width:520px">
        <a class="h10" href="/quote-request/" style="display:inline-flex;align-items:center;justify-content:center;gap:14px;flex:1 1 220px;background:#716558;color:#fff;padding:20px 30px;font-weight:800;font-size:17px;text-transform:uppercase;box-shadow:0 6px 18px rgba(43,38,34,.2)">→ Request a Quote</a>
        <a class="h9" href="tel:8885124107" style="flex:1 1 220px;text-align:center;border:2px solid #716558;color:#716558;padding:18px 28px;font-weight:700;font-size:17px">(888) 512-4107</a>
      </div>
    </div>
  </div>
</section>

<section style="background:#F4F1EE;padding:clamp(56px,7vw,100px) 20px">
  <div style="text-align:center;max-width:1240px;margin:0 auto">
    <div style="display:inline-flex;align-items:stretch;background:#fff;color:#2B2622;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:clamp(14px,1.5vw,18px);box-shadow:0 2px 10px rgba(43,38,34,.14);margin-bottom:16px"><span style="background:#BD1E2D;width:22px;clip-path:polygon(0 0,100% 0,45% 100%,0 100%)"></span><span style="padding:9px 18px 9px 10px">What We Do</span></div><h2 style="margin:0 0 20px;font-size:clamp(28px,3.6vw,44px);line-height:1.15;font-weight:800;color:#2B2622">Our Plumbing Services</h2><div style="width:60px;height:4px;background:#BD1E2D;margin:0 auto clamp(40px,5vw,64px)"></div>
    <div style="display:grid;grid-template-columns:var(--svcCols);gap:var(--svcGap)">
      {V.services.map((s) => (<Fragment>
        <a href={s.href} style="display:flex;flex-direction:column;color:#2B2622;min-width:0" data-item="services">
          <div style="height:var(--svcImgH);border-radius:12px 12px 0 0;overflow:hidden;background:#E6E0DA;display:flex;align-items:center;justify-content:center">{s.hasImg && (<Fragment><img src={s.img} alt={s.label} style="width:100%;height:100%;object-fit:cover;display:block" /></Fragment>)}{s.noImg && (<Fragment><span style="opacity:.45;padding-bottom:30px"><Fragment set:html={s.iconBig} /></span></Fragment>)}</div>
          <div class="h11" style="position:relative;flex:1;margin:var(--svcPull);background:#fff;border-radius:12px;box-shadow:0 8px 24px rgba(43,38,34,.14);padding:var(--svcPad);text-align:center;display:flex;flex-direction:column;align-items:center;gap:var(--svcInner)">
            <span style="position:absolute;top:var(--svcIconTop);left:50%;margin-left:var(--svcIconTop);width:var(--svcIconBox);height:var(--svcIconBox);border-radius:8px;background:#716558;display:flex;align-items:center;justify-content:center"><Fragment set:html={s.iconW} /></span>
            <span style="font-weight:800;font-size:var(--svcName);line-height:1.25;flex:1;display:flex;align-items:center">{s.label}</span>
            <span style="color:#716558;font-weight:700;font-size:var(--svcCta);border-bottom:2px solid #BD1E2D;padding-bottom:2px">{s.cta}</span>
          </div>
        </a>
      </Fragment>))}
    </div>
  </div>
</section>

<section style="background:#fff;padding:clamp(56px,7vw,100px) 20px">
  <div style="text-align:center;max-width:1240px;margin:0 auto">
    <div style="display:inline-flex;align-items:stretch;background:#F4F1EE;color:#2B2622;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:clamp(14px,1.5vw,18px);box-shadow:0 2px 10px rgba(43,38,34,.14);margin-bottom:16px"><span style="background:#BD1E2D;width:22px;clip-path:polygon(0 0,100% 0,45% 100%,0 100%)"></span><span style="padding:9px 18px 9px 10px">Why JBG</span></div><h2 style="margin:0 0 20px;font-size:clamp(32px,4.2vw,56px);line-height:1.08;font-weight:800;color:#2B2622">Why Choose Us?</h2>
    <div style="width:60px;height:4px;background:#BD1E2D;margin:0 auto 28px"></div>
    <div style="text-align:left;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:clamp(20px,4vw,56px)">
      <p style="margin:0;font-size:19px;line-height:1.7">Because we would choose JBG. After all, JBG is just like you. We own properties that require plumbing attention. We know what it's like to trust "professionals." We recognize when a job is done right the first time. We appreciate businesses that stand behind their work, communicate effectively, and prioritize customer service — you do too.</p>
      <p style="margin:0;font-size:19px;line-height:1.7">We want to be the kind of company we would want to hire. We've built a strong reputation throughout Texas and every job reinforces that reputation. We look people in the eye and deliver a great service at a competitive price. If we do that every single day, people will continue to notice. When capable professionals treat customers well, people trust them. That's why folks continue to choose us for their plumbing. JBG is building a Texas tradition one repair, one install, one customer at a time!</p>
    </div>
    <div style="margin-top:clamp(40px,5vw,72px);border-radius:8px;overflow:hidden;box-shadow:0 14px 36px rgba(43,38,34,.16);border-bottom:6px solid #716558;background:#F4F1EE"><img src="/uploads/Team-banner50-1%20(1).webp" alt="JBG Commercial Plumbing team" style="display:block;width:100%;height:auto" /></div>
  </div>
</section>

<section id="testimonials" style="background:#F4F1EE;padding:clamp(56px,7vw,96px) 20px">
  <div style="max-width:1240px;margin:0 auto">
    <div style="text-align:center;margin-bottom:clamp(32px,4vw,48px)">
      <div style="display:inline-flex;align-items:stretch;background:#fff;color:#2B2622;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:clamp(14px,1.5vw,18px);box-shadow:0 2px 10px rgba(43,38,34,.14);margin-bottom:16px"><span style="background:#BD1E2D;width:22px;clip-path:polygon(0 0,100% 0,45% 100%,0 100%)"></span><span style="padding:9px 18px 9px 10px">GOOGLE REVIEWS</span></div>
      <h2 style="margin:0 0 16px;font-family:'Lato',sans-serif;font-weight:900;text-transform:uppercase;color:#2B2622;font-size:clamp(30px,4vw,48px);line-height:1.08">WHAT OUR CUSTOMERS SAY</h2>
      <div style="width:46px;height:3px;background:#BD1E2D;margin:0 auto 16px"></div>
      <p style="margin:0;font-family:'Lato',sans-serif;font-weight:400;font-size:16px;color:#5A5046">4.7 stars from 558 Google reviews.</p>
    </div>
    <div style="column-count:var(--revCols);column-gap:24px">
      {V.visibleReviews.map((r) => (<Fragment>
        <div style="break-inside:avoid;display:block;margin:0 0 24px;background:#fff;border:1px solid #E6E0DA;border-radius:6px;padding:24px;animation:jbgFade .5s ease both" data-item="visibleReviews" hidden={r.hidden}>
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
            <div style="font-family:'Lato',sans-serif;font-weight:700;font-size:16px;color:#2B2622;text-transform:none;letter-spacing:0" data-name>{r.name}</div>
            <svg width="22" height="22" viewBox="0 0 48 48" style="flex:0 0 22px;display:block"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path></svg>
          </div>
          <div style="display:flex;align-items:center;gap:8px;margin:6px 0 14px"><span style="color:#FABB05;font-size:18px;letter-spacing:1px;line-height:1">★★★★★</span><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#716558" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block"><circle cx="12" cy="12" r="10"></circle><path d="M7.5 12.5l3 3 6-6.5"></path></svg></div>
          <div style="font-family:'Lato',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3A3530;white-space:pre-line" data-full={r.fullText} data-text>{r.shownText}</div>
          {r.long && (<Fragment><button class="h12" data-act="rev-toggle" style="margin-top:10px;padding:0;border:none;background:none;cursor:pointer;font-family:'Lato',sans-serif;font-weight:700;font-size:14px;color:#716558" data-label>{r.toggleLabel}</button></Fragment>)}
        </div>
      </Fragment>))}
    </div>
    <div style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:18px;margin-top:12px">
      <div style="font-family:'Lato',sans-serif;font-size:14px;color:#5A5046">Showing <span data-shown>{V.shownCount}</span> of {V.totalCount} reviews</div>
      {V.canLoadMore && (<Fragment>
        <button class="h7" data-act="more" data-list="visibleReviews" data-step={6} style="background:#716558;color:#fff;border:none;border-radius:4px;min-height:48px;padding:0 32px;font-family:'Lato',sans-serif;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:.08em;cursor:pointer">LOAD MORE REVIEWS</button>
      </Fragment>)}
      <a class="h12" href="/reviews/" style="color:#716558;font-family:'Lato',sans-serif;font-weight:700;font-size:15px">Read all reviews →</a>
    </div>
  </div>
</section>
<section style="background:#2B2622;color:#fff;padding:clamp(56px,7vw,96px) 20px">
  <div style="text-align:center;max-width:1240px;margin:0 auto">
    <div style="display:inline-flex;align-items:stretch;background:#fff;color:#2B2622;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:clamp(14px,1.5vw,18px);box-shadow:0 2px 10px rgba(43,38,34,.14);margin-bottom:16px"><span style="background:#BD1E2D;width:22px;clip-path:polygon(0 0,100% 0,45% 100%,0 100%)"></span><span style="padding:9px 18px 9px 10px">What You Get</span></div><h2 style="margin:0 0 20px;font-size:clamp(30px,4vw,48px);line-height:1.1;font-weight:800">Services we offer:</h2><div style="width:60px;height:4px;background:#BD1E2D;margin:0 auto 32px"></div>
    <div style="text-align:left;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:18px">
      {V.offers.map((o) => (<Fragment>
        <div style="display:flex;align-items:center;gap:16px;background:#38322D;border:1px solid #4A423B;border-radius:6px;padding:22px" data-item="offers">
          <span style="flex:0 0 52px;height:52px;border-radius:6px;background:#716558;display:flex;align-items:center;justify-content:center"><Fragment set:html={o.icon} /></span>
          <span style="font-weight:700;font-size:19px;line-height:1.25">{o.label}</span>
        </div>
      </Fragment>))}
    </div>
  </div>
</section>
