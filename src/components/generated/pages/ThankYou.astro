---
// GENERATED by tools/convert.mjs from the Claude Design prototype. Do not edit
// by hand: change the design (or the converter) and run `npm run convert`.
import { type PageKey } from '../../../data/vals';
interface Props { page: PageKey }

---
<section data-screen-label="Thank You Hero" style="position:relative;overflow:hidden;height:380px;display:flex;align-items:center;background:#716558;color:#fff;padding:0 20px">
  <div style="position:absolute;inset:-20px;background:url('https://i0.wp.com/jbgplumbingtx.com/wp-content/uploads/2016/12/JBG-Commercial-Plumbing-Team-Photo.jpg') center/cover no-repeat;filter:blur(7px)"></div>
  <div style="position:absolute;inset:0;background:rgba(113,101,88,.8)"></div>
  <div style="position:relative;width:100%;max-width:1240px;margin:0 auto">
    <h1 style="margin:0;font-size:clamp(44px,7vw,96px);line-height:1;font-weight:900;color:#fff">Thank You!</h1>
    <div style="width:60px;height:4px;background:#BD1E2D;margin-top:20px"></div>
    <p style="margin:20px 0 0;max-width:820px;font-size:clamp(18px,1.8vw,22px);line-height:1.5;color:#fff">Your request has been received.</p>
  </div>
</section>
<section style="background:#fff;padding:clamp(56px,7vw,100px) 20px">
  <div style="max-width:760px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center;gap:20px">
    <svg width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="#716558" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:block"><circle cx="12" cy="12" r="10"></circle><path d="M7.5 12.5l3 3 6-6.5"></path></svg>
    <p style="margin:0;font-size:clamp(20px,2.2vw,26px);line-height:1.6;color:#2B2622">Thanks for reaching out to JBG Plumbing. Our team will review your request and get back to you soon.</p>
    <p style="margin:0;font-size:17px;color:#3A3530">Need help right now? We're available 24/7.</p>
    <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center">
      <a class="h15" href="tel:9797774420" style="background:#BD1E2D;color:#fff;padding:16px 32px;border-radius:4px;font-weight:800;font-size:17px">(979) 777-4420</a>
      <a class="h9" href="/" style="border:2px solid #716558;color:#716558;padding:14px 30px;border-radius:4px;font-weight:800;font-size:17px">Back to Home</a>
    </div>
  </div>
</section>
<section style="background:#F4F1EE;padding:clamp(48px,6vw,88px) 20px">
  <div style="max-width:1240px;margin:0 auto">
    <h2 style="margin:0 0 20px;text-align:center;font-size:clamp(28px,3.8vw,48px);line-height:1.12;font-weight:800;color:#2B2622">While You Wait</h2>
    <div style="width:60px;height:4px;background:#BD1E2D;margin:0 auto 32px"></div>
    <div style="display:grid;grid-template-columns:var(--gtCols);gap:24px"><a class="h11" href="/reviews/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);padding:26px 28px;color:#2B2622;min-width:0"><span style="font-weight:900;text-transform:uppercase;font-size:20px;line-height:1.2">Read Our Reviews</span><span style="font-size:26px;font-weight:700;color:#BD1E2D">→</span></a><a class="h11" href="/projects/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);padding:26px 28px;color:#2B2622;min-width:0"><span style="font-weight:900;text-transform:uppercase;font-size:20px;line-height:1.2">View Recent Projects</span><span style="font-size:26px;font-weight:700;color:#BD1E2D">→</span></a><a class="h11" href="/services/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);padding:26px 28px;color:#2B2622;min-width:0"><span style="font-weight:900;text-transform:uppercase;font-size:20px;line-height:1.2">Our Services</span><span style="font-size:26px;font-weight:700;color:#BD1E2D">→</span></a></div>
  </div>
</section>
