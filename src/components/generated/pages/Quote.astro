---
// GENERATED by tools/convert.mjs from the Claude Design prototype. Do not edit
// by hand: change the design (or the converter) and run `npm run convert`.
import { vals, type PageKey } from '../../../data/vals';
interface Props { page: PageKey }
const { page } = Astro.props;
const V = vals(page);
---
<section data-screen-label="Request a Quote Hero" style="position:relative;overflow:hidden;height:380px;display:flex;align-items:center;background:#716558;color:#fff;padding:0 20px">
  <div style="position:absolute;inset:-20px;background:url('https://i0.wp.com/jbgplumbingtx.com/wp-content/uploads/2016/12/JBG-Commercial-Plumbing-Team-Photo.jpg') center/cover no-repeat;filter:blur(7px)"></div>
  <div style="position:absolute;inset:0;background:rgba(113,101,88,.8)"></div>
  <div style="position:relative;width:100%;max-width:1240px;margin:0 auto">
    <h1 style="margin:0;font-size:clamp(44px,7vw,96px);line-height:1;font-weight:900;color:#fff">Request a Quote</h1>
    <div style="width:60px;height:4px;background:#BD1E2D;margin-top:20px"></div>
    <p style="margin:20px 0 0;max-width:720px;font-size:clamp(18px,1.8vw,22px);line-height:1.5;color:#fff">Tell us about your project and we'll get back to you.</p>
  </div>
</section>
<section style="background:#F4F1EE;padding:clamp(48px,6vw,88px) 20px">
  <div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:var(--qCols);gap:clamp(24px,3vw,40px);align-items:start">
    <div style="background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 8px 24px rgba(43,38,34,.12);padding:clamp(24px,3.4vw,44px);min-width:0">
      <div data-state="sent" hidden>
        <div style="text-align:center;padding:48px 0">
          <div style="width:64px;height:64px;border-radius:50%;background:#716558;color:#fff;font-size:32px;display:flex;align-items:center;justify-content:center;margin:0 auto 18px">✓</div>
          <h3 style="margin:0 0 8px;font-size:30px;font-weight:800;color:#2B2622">Thank you!</h3>
          <p style="margin:0;font-size:18px;line-height:1.6">Your request has been received. Our team will reach out to you soon.</p>
        </div>
      </div>
      <div data-state="form">
      <form data-form="quote" novalidate style="display:flex;flex-direction:column;gap:28px">
        <p style="margin:0;font-size:18px;line-height:1.6">Fill out the form below and our team will reach out. Fields marked * are required.</p>
        <div>
          <span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Work Type<span style="color:#BD1E2D">*</span></span>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));gap:12px">
            {V.wtOpts.map((o) => (<Fragment>
              <button type="button" data-act="pick" aria-pressed={o.on ? 'true' : 'false'} style={`display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;min-height:130px;padding:18px 12px;border-radius:6px;border:2px solid ${o.bd};background:${o.bg};color:${o.fg};font-family:inherit;font-weight:800;font-size:16px;line-height:1.25;cursor:pointer`} data-item="wtOpts" data-val={o.label}><span style="display:flex"><Fragment set:html={o.icon} /></span>{o.label}</button>
            </Fragment>))}
          </div>
          <span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="wt"></span>
        </div>
        <div>
          <span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Name</span>
          <div style="display:grid;grid-template-columns:var(--qPair);gap:14px">
            <div><span style="display:block;font-weight:700;font-size:14px;color:#716558;margin:0 0 6px">First</span><div style="min-width:0"><input class="f1" type="text" name="first" aria-label="First" style={`border:1.5px solid ${V.qb.first};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;`} /><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="first"></span></div></div>
            <div><span style="display:block;font-weight:700;font-size:14px;color:#716558;margin:0 0 6px">Last</span><div style="min-width:0"><input class="f1" type="text" name="last" aria-label="Last" style={`border:1.5px solid ${V.qb.last};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;`} /><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="last"></span></div></div>
          </div>
        </div>
        <div><span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Phone</span><div style="min-width:0"><input class="f1" type="tel" name="phone" aria-label="Phone" style={`border:1.5px solid ${V.qb.phone};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;`} /><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="phone"></span></div></div>
        <div><span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Email</span><div style="min-width:0"><input class="f1" type="email" name="email" aria-label="Email" style={`border:1.5px solid ${V.qb.email};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;`} /><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="email"></span></div></div>
        <div>
          <span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Service Address<span style="color:#BD1E2D">*</span></span>
          <div style="display:grid;grid-template-columns:var(--qAddr);gap:14px">
            <div><span style="display:block;font-weight:700;font-size:14px;color:#716558;margin:0 0 6px">Street Address</span><div style="min-width:0"><input class="f1" type="text" name="street" aria-label="Street Address" style={`border:1.5px solid ${V.qb.street};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;`} /><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="street"></span></div></div>
            <div><span style="display:block;font-weight:700;font-size:14px;color:#716558;margin:0 0 6px">ZIP Code</span><div style="min-width:0"><input class="f1" type="text" name="zip" aria-label="ZIP Code" style={`border:1.5px solid ${V.qb.zip};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;`} /><span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="zip"></span></div></div>
          </div>
        </div>
        <div>
          <span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px">Service Requested<span style="color:#BD1E2D">*</span></span>
          <textarea class="f1" rows="6" name="service" aria-label="Service Requested" style={`border:1.5px solid ${V.qb.service};border-radius:4px;padding:14px 16px;font-size:17px;font-family:inherit;color:#2B2622;background:#fff;width:100%;box-sizing:border-box;outline:none;resize:vertical;line-height:1.5`}></textarea>
          <span style="display:block;margin-top:6px;font-size:14.5px;font-weight:700;color:#BD1E2D" hidden data-err="service"></span>
        </div>
        <div>
          <span style="display:block;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:#2B2622;margin:0 0 8px;text-transform:none;letter-spacing:0;font-size:16px">RFP's, plans, or any other related commercial files you want to share</span>
          <label data-drop style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;padding:30px 16px;border:2px dashed #716558;border-radius:6px;background:#F4F1EE;cursor:pointer;font-size:17px;color:#2B2622">
            <input type="file" multiple="" name="files" data-files style="display:none" />
            <span>Drop files here or <span style="font-weight:800;color:#BD1E2D;text-decoration:underline">Select files</span></span>
            <span data-file-list style="display:contents"></span>
          </label>
          <span style="display:block;margin-top:8px;font-size:14.5px;color:#716558">Max. file size: 128 MB.</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:14px;align-items:flex-start">
          <button class="h12" type="submit" style="background:#BD1E2D;color:#fff;border:0;border-radius:4px;padding:18px 40px;font-family:inherit;font-weight:800;font-size:17px;cursor:pointer">Request a Quote</button>
          <span style="font-size:15.5px;color:#3A3530">For emergencies, call us 24/7 at <a class="h15" href="tel:9797774420" style="font-weight:700;color:#716558">(979) 777-4420</a>.</span>
        </div>
      </form>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
      <div style="background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 4px 14px rgba(43,38,34,.1);padding:26px;display:flex;flex-direction:column;gap:10px">
        <h3 style="margin:0;font-weight:900;text-transform:uppercase;letter-spacing:.02em;font-size:22px;line-height:1.2;color:#2B2622">Need help now?</h3>
        <p style="margin:0;font-size:17px;line-height:1.6">We're available 24/7 for plumbing emergencies.</p>
        <a class="h12" href="tel:9797774420" style="text-align:center;background:#BD1E2D;color:#fff;padding:15px 24px;border-radius:4px;font-weight:800;font-size:17px">(979) 777-4420</a>
      </div>
      <div style="background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 4px 14px rgba(43,38,34,.1);padding:26px;display:flex;flex-direction:column;gap:10px">
        <h3 style="margin:0;font-weight:900;text-transform:uppercase;letter-spacing:.02em;font-size:22px;line-height:1.2;color:#2B2622">Prefer to book online?</h3>
        <p style="margin:0;font-size:17px;line-height:1.6">Pick a time that works for you.</p>
        <a class="h12" href="https://book.housecallpro.com/book/JBG-Plumbing/4e36de049beb46bc86918c304ca376cb" target="_blank" rel="noopener" style="text-align:center;background:#716558;color:#fff;padding:15px 24px;border-radius:4px;font-weight:800;font-size:17px">Book Online</a>
      </div>
      <div style="background:#fff;border-radius:6px;border-top:4px solid #BD1E2D;box-shadow:0 4px 14px rgba(43,38,34,.1);padding:26px;display:flex;flex-direction:column;gap:10px;border-top-color:#716558">
        <h3 style="margin:0;font-weight:900;text-transform:uppercase;letter-spacing:.02em;font-size:22px;line-height:1.2;color:#2B2622">Our Office</h3>
        <span style="font-weight:800;font-size:17px;color:#2B2622">JBG Plumbing</span>
        <span style="font-size:17px;line-height:1.5">580 Graham Rd Ste D, College Station, TX 77845</span>
        <a class="h15" href="tel:9797774420" style="font-weight:700;font-size:18px;color:#716558">(979) 777-4420</a>
        <span style="font-size:16px;line-height:1.5;color:#3A3530">Serving Brazos, Milam, Robertson and Grimes County</span>
      </div>
    </div>
  </div>
</section>
