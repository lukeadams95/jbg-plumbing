---
import '../styles/base.css';
import '../styles/responsive.css';
import '../styles/generated.css';
import Header from '../components/generated/Header.astro';
import Cta from '../components/generated/Cta.astro';
import Footer from '../components/generated/Footer.astro';
import MobileCallBar from '../components/generated/MobileCallBar.astro';
import { NO_CTA, type PageKey } from '../data/vals';
import { pageTitle } from '../data/meta';

interface Props { page: PageKey; title?: string; noindex?: boolean }
const { page, title, noindex } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// GA4 Measurement ID (JBG Plumbing property 565708776, stream 16401960953).
// Leave empty to ship no analytics tag.
const GA_ID = 'G-JT80NKDX4D';
const GA_SRC = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
// Only the live domain loads GA, so pages.dev staging and previews don't count.
const GA_HOSTS = ['bcsplumber.com'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ?? pageTitle(page)}</title>
  {!noindex && page !== 'booked' && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/uploads/JBG-logo1.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap" />
  {page === 'booked'
    ? <meta name="robots" content="noindex,nofollow" />
    : (noindex || page === 'thanks') && <meta name="robots" content="noindex" />}
  {GA_ID && <script is:inline define:vars={{ GA_ID, GA_SRC, GA_HOSTS }}>
    if (GA_HOSTS.includes(location.hostname)) {
      var s = document.createElement('script'); s.async = true; s.src = GA_SRC; document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){ window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
    }
  </script>}
  <!-- Feedbucket review widget: staging site (jbg-plumbing.pages.dev) only. -->
  <script is:inline type="text/javascript">
    if (location.hostname === 'jbg-plumbing.pages.dev') {
      (function(k) {
        let s=document.createElement('script');s.defer=true;
        s.src="https://cdn.feedbucket.app/assets/feedbucket.js";
        s.dataset.feedbucket=k;document.head.appendChild(s);
      })('55FCUYP4nZ7LB1xtff3j')
    }
  </script>
</head>
<body data-page={page}>
  <div style="font-family:'Lato',Helvetica,Arial,sans-serif;color:#3A3530;line-height:1.7">
    <Header page={page} />
    <main><slot /></main>
    {!NO_CTA.includes(page) && <Cta page={page} />}
    <Footer page={page} />
    <MobileCallBar page={page} />
  </div>
  <script>
    import '../scripts/site';
  </script>
</body>
</html>
